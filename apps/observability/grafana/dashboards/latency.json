    "list": [
      {
        "type": "query",
        "name": "route",
        "label": "Route",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(http_server_request_duration_seconds, http_route)",
        "query": {
          "query": "label_values(http_server_request_duration_seconds, http_route)",
          "refId": "route"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "type": "custom",
        "name": "status",
        "label": "Status",
        "query": "All : .*,2xx : 2..,3xx : 3..,4xx : 4..,5xx : 5..",
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "text": "All",
            "value": ".*",
            "selected": true
          },
          {
