          "expr": "quantile_over_time(0.95, {service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | unwrap request_time | __error__=\"\" [$__auto]) by (host)",
          "queryType": "range",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
