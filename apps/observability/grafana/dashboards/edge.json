{
  "uid": "edge",
  "title": "Edge",
  "tags": ["qafiyah"],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timepicker": {},
  "timezone": "",
  "links": [
    {
      "type": "dashboards",
      "tags": ["qafiyah"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Qafiyah",
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Every request the website's nginx answered**: pages served from its cache, pages Astro rendered, static files, and API requests through the website, timed by nginx from receiving the request to sending the last byte (`request_time`, to the millisecond, so a cache hit often reads 0). The edge gateway's own time and Cloudflare are not included. **Cache status** is nginx's page cache: HIT, MISS, EXPIRED, STALE, BYPASS, or none when the response is not cacheable. Percentiles come from the raw logged times over the range, with the same thresholds as the latency dashboard (p95 needs 100 requests, p99 needs 500). The data is the website's access log in Loki, kept 14 days."
      }
    },
    {
      "type": "stat",
      "title": "Page-cache hit ratio",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | cache=~\"HIT|STALE|UPDATING|REVALIDATED\" [$__range])) / sum(count_over_time({service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | cache!=\"\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Requests nginx answered in the range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "table",
      "title": "Latency by cache status",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (cache) (count_over_time({service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | label_format cache=`{{ if .cache }}{{ .cache }}{{ else }}none{{ end }}` [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.5, {service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | label_format cache=`{{ if .cache }}{{ .cache }}{{ else }}none{{ end }}` | unwrap request_time | __error__=\"\" [$__range]) by (cache)",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | label_format cache=`{{ if .cache }}{{ .cache }}{{ else }}none{{ end }}` | unwrap request_time | __error__=\"\" [$__range]) by (cache) and on (cache) (sum by (cache) (count_over_time({service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | label_format cache=`{{ if .cache }}{{ .cache }}{{ else }}none{{ end }}` [$__range])) >= 100)",
          "queryType": "instant"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.99, {service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | label_format cache=`{{ if .cache }}{{ .cache }}{{ else }}none{{ end }}` | unwrap request_time | __error__=\"\" [$__range]) by (cache) and on (cache) (sum by (cache) (count_over_time({service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | label_format cache=`{{ if .cache }}{{ .cache }}{{ else }}none{{ end }}` [$__range])) >= 500)",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "cache": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "cache": "Cache",
              "Value #A": "Requests",
              "Value #B": "p50",
              "Value #C": "p95",
              "Value #D": "p99"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cache"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Latency by host",
