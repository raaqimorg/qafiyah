      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (cache) (rate({service=\"web\"} |= `\"source\":\"nginx\"` | json | __error__=\"\" | label_format cache=`{{ if .cache }}{{ .cache }}{{ else }}none{{ end }}` [$__auto]))",
          "queryType": "range",
