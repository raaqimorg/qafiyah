  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Up** means the last check passed: an HTTP probe of `/healthz` for the API and the website, the exporter's connection for Postgres, and a reachable cluster that is not red for Elasticsearch. **Unknown** means there is no data, so the check itself is not running; it never means up. **Metrics freshness** shows when Prometheus last scraped the API and when the website last pushed its numbers, so an empty latency view reads as a broken pipe, not as no traffic, and whether Loki (logs) and Alloy (log shipping, container and host metrics) are up. **Log lines dropped** counts what Alloy discarded because a service logged more than 10 lines a second beyond a burst of 2,000 (a flood); the metrics still count every request."
      }
    },
    {
      "type": "stat",
      "title": "API",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(probe_success{service=\"api\"})",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "up",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "down",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
