---
import { API_URL } from '@/lib/constants/config';
import { API_V1_PREFIX } from '@qafiyah/config';

type Props = {
  readonly class?: string;
};

const { class: textClass } = Astro.props;
const EXAMPLE = `curl -H "x-api-key: YOUR_KEY" ${API_URL}${API_V1_PREFIX}/meters`;
---

<pre
  class="overflow-x-auto rounded-md bg-surface-sunken px-4 py-3 text-left font-mono text-sm text-text"
  dir="ltr"
><code>{EXAMPLE}</code></pre>
<p class={textClass}>
  أرسل المفتاح في ترويسة <code dir="ltr">x-api-key</code>. ويمكنك تجربة الواجهة دون مفتاح بحدود أقل.
</p>
