---
import { countedNoun } from '@/lib/arabic';
import { INLINE_LINK } from '@/lib/constants/design-tokens';
import { REQUESTS_NOUN_FORMS } from '@/lib/constants/taxonomy-data';
import { cn } from '@/lib/utils';
import { API_EMAIL } from '@qafiyah/config';

type Props = {
  readonly class?: string;
  readonly plan?: string | undefined;
};

const { class: textClass, plan } = Astro.props;

const LIMITS = [
  { plan: 'anonymous', tier: 'بلا مفتاح', requests: 60 },
  { plan: 'free', tier: 'مفتاح مجاني', requests: 500 },
] as const;
const FREE_BURST_PER_SECOND = 10;
const FREE_CEILING_PER_ADDRESS = 1500;
---

<ul class="flex flex-col">
  {LIMITS.map((limit) => (
    <li
      class={cn(textClass, 'flex items-center justify-between gap-4 border-b border-border py-3')}
    >
      <span class="flex items-center gap-2 text-text">
        {limit.tier}
        {limit.plan === plan && (
          <span class="rounded-md border border-border px-2 py-0.5 text-sm text-text-muted">
            خطتك
          </span>
        )}
      </span>
      <span class="text-text-muted">
        {limit.requests} {countedNoun(limit.requests, REQUESTS_NOUN_FORMS)} في الساعة
      </span>
    </li>
  ))}
</ul>
<p class={textClass}>
  ولا يتجاوز المفتاح المجاني {FREE_BURST_PER_SECOND}{' '}
  {countedNoun(FREE_BURST_PER_SECOND, REQUESTS_NOUN_FORMS)} في الثانية، ولا{' '}
  {FREE_CEILING_PER_ADDRESS} {countedNoun(FREE_CEILING_PER_ADDRESS, REQUESTS_NOUN_FORMS)} في الساعة
  من العنوان الواحد.
</p>
<p class={textClass}>
  تحمل الاستجابات الخاضعة لحدود الاستخدام ترويسة <code dir="ltr">x-ratelimit-remaining</code> لتعرف
  ما تبقّى لك. وإن احتجت حدودًا أعلى فراسلنا على{' '}
  <a href={`mailto:${API_EMAIL}`} class={INLINE_LINK}>
    البريد
  </a>
  .
</p>
