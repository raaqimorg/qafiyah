---
import { BANNER_IMAGE_SIZE, type Sponsor, type TextSponsor } from '@/lib/constants/sponsorship';

interface Props {
  sponsor?: Sponsor | TextSponsor | undefined;
  class?: string | undefined;
}

const { sponsor, class: className } = Astro.props;
---

<aside aria-label="رعاية الموقع" class={className}>
  {sponsor === undefined ? (
    <a
      href="/sponsorship"
      class="flex min-h-10 w-full items-center justify-center gap-2 rounded-md border border-dashed border-border px-3 py-1.5 text-center text-micro text-text-subtle transition-colors hover:border-text-subtle hover:text-text focus-ring"
    >
      <span>هذه المساحة متاحة لراعٍ واحد يدعم قافية</span>
      <span class="text-highlight underline underline-offset-4">اعرف المزيد</span>
    </a>
  ) : 'logo' in sponsor ? (
    <a
      href={sponsor.url}
      target="_blank"
      rel="sponsored noopener noreferrer"
      aria-label={`${sponsor.name}، ${sponsor.line}، ${sponsor.action}`}
      class="flex min-h-10 w-full items-center justify-center gap-2 rounded-md border border-dashed border-border px-3 py-1.5 text-center text-micro text-text-subtle transition-colors hover:border-text-subtle hover:text-text focus-ring"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 64 64"
        aria-hidden="true"
        class="size-4 shrink-0"
        set:html={sponsor.logo}
      />
      <span>
        {sponsor.name}، {sponsor.line}
      </span>
      <span class="text-highlight underline underline-offset-4">{sponsor.action}</span>
    </a>
  ) : (
    <a
      href={sponsor.url}
      target="_blank"
      rel="sponsored noopener noreferrer"
      class="block w-full overflow-hidden rounded-md focus-ring"
    >
      <img
        src={sponsor.image}
        width={BANNER_IMAGE_SIZE.width}
        height={BANNER_IMAGE_SIZE.height}
        alt={sponsor.name}
        class="block h-10 w-full object-cover"
      />
    </a>
  )}
</aside>
