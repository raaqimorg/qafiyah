---
import { SITE_THEME_COLOR_DARK_HEX, SITE_THEME_COLOR_HEX } from '@/lib/constants/site-meta';
import { THEME_STORAGE_KEY } from '@/lib/constants/config';
import {
  DEFAULT_SETTINGS,
  FONT_FAMILIES,
  SETTINGS_STORAGE_KEY,
} from '@/lib/settings/settings-schema';
---

<script
  is:inline
  data-cfasync="false"
  define:vars={{
    settingsKey: SETTINGS_STORAGE_KEY,
    legacyKey: THEME_STORAGE_KEY,
    lightColor: SITE_THEME_COLOR_HEX,
    darkColor: SITE_THEME_COLOR_DARK_HEX,
    fontFamilies: FONT_FAMILIES,
    defaultFontFamily: DEFAULT_SETTINGS.fontFamily,
  }}
>
  const root = document.documentElement;
  const query = window.matchMedia('(prefers-color-scheme: dark)');

  const readStored = () => {
    try {
      const raw = localStorage.getItem(settingsKey);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return parsed;
      }
    } catch {}
    return null;
  };

  const readTheme = () => {
    const stored = readStored();
    if (stored) {
      const theme = stored.theme;
      return theme === 'dark' || theme === 'light' || theme === 'system' ? theme : 'system';
    }
    try {
      const legacy = localStorage.getItem(legacyKey);
      if (legacy === 'dark' || legacy === 'light') return legacy;
    } catch {}
    return 'system';
  };

  const readFontFamily = () => {
    const fontFamily = readStored()?.fontFamily;
    return fontFamilies.includes(fontFamily) ? fontFamily : defaultFontFamily;
  };

  const apply = (theme) => {
    const isDark = theme === 'dark' || (theme === 'system' && query.matches);
    root.classList.toggle('dark', isDark);
    root.style.colorScheme = isDark ? 'dark' : 'light';
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', isDark ? darkColor : lightColor);
  };

  apply(readTheme());
  const fontFamily = readFontFamily();
  root.dataset.font = fontFamily;
  if (fontFamily !== defaultFontFamily) {
    const fontVariable = `--font-${fontFamily}`;
    const family = getComputedStyle(root).getPropertyValue(fontVariable).split(',')[0].trim();
    document.fonts.load(`400 1em ${family}`);
  }

  query.addEventListener('change', () => {
    if (readTheme() === 'system') apply('system');
  });
</script>
