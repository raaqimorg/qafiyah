---
import ListPageBody from '@/components/list-page-body.astro';
import Layout from '@/layouts/layout.astro';
import { reachedFirstPage, readCursor } from '@/lib/pagination';
import { CACHE_HTML } from '@/lib/server/cache';
import { buildTaxonomyTermView, loadTaxonomyTerm } from '@/lib/seo/taxonomy-pages';
import { isCanonical, taxonomyUrl } from '@/lib/urls';

const cursor = readCursor(Astro.url);
const { slug } = Astro.params;
if (!slug) return Astro.rewrite('/404');
const canonical = taxonomyUrl('themes', slug, cursor);
if (!isCanonical(Astro.url, canonical)) return Astro.redirect(canonical, 301);
const load = await loadTaxonomyTerm('themes', slug, cursor);
if (!load) return Astro.rewrite('/404');
if (reachedFirstPage(cursor, load.page)) return Astro.redirect(taxonomyUrl('themes', slug), 301);
Astro.response.headers.set('Cache-Control', CACHE_HTML);
const { layout, body } = buildTaxonomyTermView('themes', load);
---

<Layout {...layout}>
  <ListPageBody {...body} />
</Layout>
