---
import { ResultAsync } from 'neverthrow';
import type { MeterSlug, PoetSlug, RhymeSlug, ThemeSlug } from '@/lib/api/brands';
import ListPageBody from '@/components/list-page-body.astro';
import { PoetPoems } from '@/components/poet-poems';
import { ShareButton } from '@/components/share-button';
import Layout from '@/layouts/layout.astro';
import { SHARE_TEXTS } from '@/lib/constants/copy';
import { TYPE } from '@/lib/constants/design-tokens';
import { buildPoetLayout } from '@/lib/seo/poets-page';
import { reachedFirstPage, readCursor } from '@/lib/pagination';
import {
  everyPoetFilterListed,
  hasPoetFilters,
  type PoetFilterSelection,
} from '@/lib/poet-filters';
import { loadPoetSearchParams } from '@/lib/poet-search-params';
import { reportError } from '@/lib/observability/report-error';
import { CACHE_HTML, CACHE_NONE } from '@/lib/server/cache';
import { listPoems } from '@/lib/server/poems';
import { getPoet, getPoetFacets, movedPoetPath } from '@/lib/server/poets';
import { isCanonical, poetUrl } from '@/lib/urls';
import { CDN_URL } from '@qafiyah/config';

const cursor = readCursor(Astro.url);
const { meter, rhyme, theme } = loadPoetSearchParams(Astro.url.searchParams);
const filters: PoetFilterSelection = { meter, rhyme, theme };
const { slug: slugParam } = Astro.params;
const poetSlug = slugParam as PoetSlug | undefined;
const canonical = poetSlug ? poetUrl(poetSlug, { ...filters, cursor }) : null;
if (canonical !== null && !isCanonical(Astro.url, canonical)) {
  return Astro.redirect(canonical, 301);
}
const [poet, list, facetsResult] = poetSlug
  ? await Promise.all([
      getPoet(poetSlug),
      listPoems(
        {
          poetSlugs: [poetSlug],
          meterSlugs: filters.meter as readonly MeterSlug[],
          rhymeSlugs: filters.rhyme as readonly RhymeSlug[],
          themeSlugs: filters.theme as readonly ThemeSlug[],
        },
        cursor
      ),
      ResultAsync.fromPromise(getPoetFacets(poetSlug, filters), (error) => error),
    ])
  : [null, null, null];
if (!poet) return Astro.rewrite('/404');
const moved = movedPoetPath(slugParam as string, poet, { ...filters, cursor });
if (moved) {
  const redirect = Astro.redirect(moved, 301);
  redirect.headers.set('Cache-Control', CACHE_HTML);
  return redirect;
}
if (!list || !facetsResult) return Astro.rewrite('/404');
if (reachedFirstPage(cursor, list)) return Astro.redirect(poetUrl(poet.slug, filters), 301);
const facets = facetsResult.match(
  (value) => value,
  (error) => {
    reportError('poet facets failed', error, {
      feature: 'poet-poem-filters',
      tags: { surface: 'server' },
    });
    return undefined;
  }
);
if (facets === null || (facets !== undefined && !everyPoetFilterListed(filters, facets))) {
  return Astro.rewrite('/404');
}
Astro.response.headers.set('Cache-Control', facets === undefined ? CACHE_NONE : CACHE_HTML);
const slug = poet.slug;
const isFiltered = hasPoetFilters(filters);

const BIO_CLASS = `${TYPE.body} text-text-muted leading-[1.8]`;
const BIO_ID = 'poet-bio';
const BIO_TOGGLE_ID = 'poet-bio-toggle';
const BIO_CLAMP_CLASS = 'line-clamp-5 xs:line-clamp-3 data-expanded:line-clamp-none';
const TOGGLE_CLASS =
  'group self-start rounded-sm text-text underline underline-offset-4 transition-colors hover:text-text-muted focus-visible:ring-1 focus-visible:ring-text focus-visible:outline-none';

const {
  title,
  description,
  heading,
  subtitle,
  avatarUrl,
  socialImage,
  bio,
  pag,
  personJsonLd,
  worksJsonLd,
  crumbItems,
  crumbsJsonLd,
} = buildPoetLayout({ poet, page: list, filters });
---

<Layout
  title={title}
  description={description}
  canonical={poetUrl(slug, { ...filters, cursor })}
  robotsIndex={!isFiltered}
  prevUrl={pag.prevUrl}
  nextUrl={pag.nextUrl}
  ogType="profile"
  ogTitle={title}
  ogDescription={description}
  socialImage={socialImage}
  twitterTitle={title}
  twitterDescription={description}
  preconnect={avatarUrl ? [CDN_URL] : []}
  jsonLd={[personJsonLd, worksJsonLd, crumbsJsonLd]}
>
  <ListPageBody heading={heading} crumbItems={crumbItems}>
    <div slot="header" class="flex w-full items-center gap-4 xs:gap-5">
      {avatarUrl && (
        <div class="relative size-24 shrink-0">
          <div class="absolute inset-0 animate-pulse rounded-lg bg-surface-sunken" />
          <img
            src={avatarUrl}
            alt={heading}
            width="96"
            height="96"
            decoding="async"
            fetchpriority="high"
            class="absolute inset-0 size-24 rounded-lg object-cover object-top"
          />
        </div>
      )}
      <div class="flex min-w-0 flex-col gap-2">
        <div class="flex items-start">
          <h1 class={`${TYPE.title} min-w-0 text-text`}>{heading}</h1>
          <div class="flex h-(--title-leading) shrink-0 items-center">
            <ShareButton
              client:idle
              title={SHARE_TEXTS.poetTitle}
              body={heading}
              path={poetUrl(slug)}
              className="translate-y-0.5 md:[&_svg]:size-6"
            />
          </div>
        </div>
        <p class={`${TYPE.caption} text-text-subtle`}>{subtitle}</p>
      </div>
    </div>
    <div class="flex w-full max-w-3xl flex-col gap-3">
      {bio?.kind === 'full' && <p class={BIO_CLASS}>{bio.text}</p>}
      {bio?.kind === 'collapsed' && (
        <>
          <p id={BIO_ID} class={`${BIO_CLASS} ${BIO_CLAMP_CLASS}`}>
            {bio.text}
          </p>
          <button
            id={BIO_TOGGLE_ID}
            type="button"
            class={TOGGLE_CLASS}
            aria-expanded="false"
            aria-controls={BIO_ID}
          >
            <span class="group-aria-expanded:hidden">عرض المزيد</span>
            <span class="hidden group-aria-expanded:inline">طي</span>
          </button>
        </>
      )}
    </div>
    <PoetPoems
      client:load
      poetSlug={slug}
      serverSearch={Astro.url.search}
      poems={list}
      facets={facets}
    />
  </ListPageBody>
</Layout>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#poet-bio-toggle');
  const bio = document.querySelector<HTMLElement>('#poet-bio');
  if (toggle && bio) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(expanded));
      bio.toggleAttribute('data-expanded', expanded);
    });
  }
</script>
