---
import type { PoemSlug } from '@/lib/api/brands';
import Breadcrumbs from '@/components/breadcrumbs.astro';
import AdjacentPoems from '@/components/adjacent-poems.astro';
import { PoemDisplay } from '@/components/poem-display';
import Recensions from '@/components/recensions.astro';
import RelatedPoems from '@/components/related-poems.astro';
import Layout from '@/layouts/layout.astro';
import { buildPoemLayout } from '@/lib/seo/poem-page';
import { CACHE_HTML } from '@/lib/server/cache';
import { POEM_CONTEXTS, parsePoemContext } from '@/lib/poem-context';
import { getPoem, movedPoemPath } from '@/lib/server/poems';
import { poemUrl } from '@/lib/urls';

const { slug } = Astro.params;
const from = parsePoemContext(Astro.url.searchParams.get('from'));
const detail = slug
  ? await getPoem(slug as PoemSlug, from === undefined ? undefined : POEM_CONTEXTS[from].by)
  : null;
if (!detail) return Astro.rewrite('/404');
const moved = movedPoemPath(slug as string, detail);
if (moved) {
  const redirect = Astro.redirect(moved, 301);
  redirect.headers.set('Cache-Control', CACHE_HTML);
  return redirect;
}

Astro.response.headers.set('Cache-Control', CACHE_HTML);
const poem = detail;
const layout = buildPoemLayout(detail, slug as PoemSlug, from);
---

<Layout
  title={layout.title}
  description={layout.description}
  canonical={layout.canonical}
  prevUrl={layout.adjacentPoems.prevHref}
  nextUrl={layout.adjacentPoems.nextHref}
  ogType="article"
  ogTitle={layout.ogTitle}
  ogDescription={layout.ogDescription}
  twitterTitle={layout.twitterTitle}
  twitterDescription={layout.twitterDescription}
  articleAuthor={layout.articleAuthor}
  articleSection={layout.articleSection}
  jsonLd={layout.jsonLd}
>
  <div class="w-full">
    <div class="pt-8 xs:pt-10">
      <Breadcrumbs items={layout.crumbItems} />
      {
        poem.recensionOf && (
          <p class="text-text-subtle">
            هذه رواية أخرى لقصيدة{' '}
            <a class="underline" href={poemUrl(poem.recensionOf.slug)}>
              {poem.recensionOf.title}
            </a>
          </p>
        )
      }
    </div>
    <div class="my-14 flex w-full flex-col items-center gap-10 xs:my-20 lg:my-28">
      <div class="flex w-full max-w-5xl flex-col items-center gap-10">
        <PoemDisplay
          client:idle
          title={poem.title}
          poet={poem.poet}
          era={poem.era}
          meter={poem.meter}
          theme={poem.theme}
          verses={poem.verses}
          verseCount={poem.verseCount}
          poemType={poem.poemType}
        />
      </div>
      <AdjacentPoems
        label={layout.adjacentPoems.label}
        prevHref={layout.adjacentPoems.prevHref}
        prevTitle={layout.adjacentPoems.prevTitle}
        nextHref={layout.adjacentPoems.nextHref}
        nextTitle={layout.adjacentPoems.nextTitle}
        hidden={layout.adjacentPoems.hidden}
      />
      <Recensions recensions={poem.recensions} />
      <RelatedPoems relatedPoems={poem.relatedPoems} />
    </div>
  </div>
</Layout>
