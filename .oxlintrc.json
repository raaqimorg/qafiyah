{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.next",
    "**/.turbo",
    "**/coverage",
    "**/*.min.js",
    "**/data",
    "**/env.d.ts",
    "**/worker-configuration.d.ts",
    "apps/web/.astro"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": "off",
    "vitest/require-mock-type-parameters": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-depth": "off",
    "max-nested-callbacks": "off",
    "max-params": "off",
    "max-statements": "off",
    "import/max-dependencies": "off",
    "no-inline-comments": "off",
    "sort-vars": "off",
    "sort-keys": "off",
    "sort-imports": "off",
    "no-await-in-loop": "off",
    "require-unicode-regexp": "off",
    "no-ternary": "off",
    "no-magic-numbers": "off",
    "id-length": "off",
    "func-style": "off",
    "no-undefined": "off",
    "init-declarations": "off",
    "no-continue": "off",
    "no-plusplus": "off",
    "no-bitwise": "off",
    "prefer-destructuring": "off",
    "capitalized-comments": "off",
    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/max-nested-calls": "off",
    "no-console": [
      "warn",
      {
        "allow": ["error", "warn"]
      }
    ],
    "node/no-process-env": "error",
    "eqeqeq": "error",
    "no-eq-null": "error",
    "no-shadow": "error",
    "no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "no-else-return": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "prefer-const": "error",
    "prefer-template": "error",
    "prefer-regex-literals": "error",
    "prefer-arrow-callback": [
      "error",
      {
        "allowNamedFunctions": true
      }
    ],
    "prefer-exponentiation-operator": "error",
    "operator-assignment": "error",
    "symbol-description": "error",
    "one-var": ["error", "never"],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@qafiyah/web",
            "message": "Cross-app imports are forbidden. Move shared code to packages/*."
          },
          {
            "name": "@qafiyah/api",
            "message": "Cross-app imports are forbidden. apps/web reaches the API via oRPC over HTTP."
          }
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-namespace": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/default-param-last": "error",
    "typescript/parameter-properties": "error",
    "typescript/only-throw-error": "error",
    "typescript/array-type": [
      "error",
      {
        "default": "array"
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "string": true
        }
      }
    ],
    "typescript/no-implied-eval": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/new-for-builtins": "error",
    "unicorn/no-lonely-if": "error",
    "typescript/prefer-for-of": "error",
    "unicorn/throw-new-error": "error",
    "import/no-cycle": "error",
    "import/no-commonjs": "error",
    "oxc/no-barrel-file": "warn",
    "react/jsx-fragments": "error",
    "unicorn/prefer-number-coercion": "off",
    "oxc/no-map-spread": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/control-has-associated-label": [
      "error",
      {
        "depth": 3
      }
    ],
    "react/no-deriving-state-in-effects": "warn",
    "react/set-state-in-effect": "warn",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/strict-void-return": "off",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-deprecated": "error",
    "typescript/return-await": ["error", "always"],
    "typescript/no-confusing-void-expression": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-useless-undefined": "off",
    "no-warning-comments": "off",
    "react/no-unstable-nested-components": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.astro"],
      "rules": {
        "no-unused-vars": "off",
        "typescript/no-unused-vars": "off",
        "import/no-default-export": "off",
        "node/no-process-env": "off",
        "typescript/no-floating-promises": "off",
        "no-console": "off",
        "promise/always-return": "off",
        "promise/no-callback-in-promise": "off"
      }
    },
    {
      "files": ["apps/search-indexer/**"],
      "rules": {
        "no-console": "off",
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/env.ts",
        "**/src/env.ts",
        "**/src/server.ts",
        "**/vitest.setup.ts",
        "**/vitest.config.ts"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test-utils.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "no-empty-function": "off",
        "require-await": "off",
        "typescript/require-await": "off",
        "node/no-process-env": "off",
        "typescript/no-floating-promises": "off",
        "vitest/no-conditional-in-test": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/require-to-throw-message": "off",
        "unicorn/consistent-function-scoping": "off",
        "typescript/consistent-type-imports": "off",
        "promise/no-promise-in-callback": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/prefer-readonly-parameter-types": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": [
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "scripts/**",
        "**/scripts/**",
        "**/*.run.ts",
        "**/*.cjs"
      ],
      "rules": {
        "import/no-commonjs": "off",
        "import/no-default-export": "off",
        "node/no-process-env": "off",
        "no-console": "off",
        "import/no-nodejs-modules": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/prefer-readonly-parameter-types": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      "files": ["packages/*/src/index.ts"],
      "rules": {
        "oxc/no-barrel-file": "off"
      }
    }
  ]
}
