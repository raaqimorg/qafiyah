{
  "name": "qafiyah",
  "private": true,
  "scripts": {
    "agents:link": "bun scripts/dev/link-agent-files.ts",
    "api:conformance": "bun scripts/api/conformance.ts",
    "build": "turbo run build",
    "build:images": "bun scripts/deploy/build-images.ts",
    "check:boundaries": "bun scripts/check/boundaries.ts",
    "check:constants": "bun scripts/check/constants.ts",
    "check:dockerfiles": "bun scripts/check/dockerfiles.ts",
    "check:naming": "bun scripts/check/naming.ts",
    "check:no-parent-imports": "bun scripts/check/no-parent-imports.ts",
    "check:rust-toolchain": "bun scripts/check/rust-toolchain.ts",
    "check:shell": "bun scripts/check/shell.ts",
    "check:sql": "bun scripts/check/sql.ts && squawk --no-error-on-unmatched-pattern 'apps/api/migrations/*.sql'",
    "check:syncpack": "syncpack lint",
    "check:workflows": "actionlint",
    "ci": "bun scripts/ci.ts",
    "clean": "./scripts/dev/clean.sh",
    "corpus:apply-classical": "bun scripts/corpus/apply-verdicts.ts",
    "corpus:verify-classical": "bun scripts/corpus/verify-classical.ts",
    "db:reseed": "./scripts/db/reseed.sh",
    "db:reset": "./scripts/dev/db-reset.sh",
    "db:up": "./scripts/dev/db-up.sh",
    "depcruise": "bunx --bun depcruise --config .dependency-cruiser.cjs apps packages",
    "deploy": "./scripts/deploy/vps.sh",
    "dev": "bun scripts/dev/run.ts",
    "dev:preflight": "bun scripts/dev/preflight.ts",
    "down": "./scripts/dev/compose.sh down",
    "dump:key:check": "./scripts/dev/check-dump-key.sh",
    "dump:key:set": "./scripts/dev/set-dump-key.sh",
    "es:diff": "bun scripts/es/diff.ts",
    "es:down": "./scripts/dev/compose.sh stop elasticsearch",
    "es:query:check": "bun scripts/es/query-snapshot.ts --check",
    "es:query:snapshot": "bun scripts/es/query-snapshot.ts",
    "es:snapshot": "bun scripts/es/snapshot.ts",
    "es:up": "./scripts/dev/compose.sh up -d --wait elasticsearch",
    "format": "oxfmt . && prettier --write --log-level warn '**/*.astro'",
    "format:check": "oxfmt --check . && prettier --check '**/*.astro'",
    "knip": "knip",
    "lint": "oxlint --type-aware --fix .",
    "lint:check": "oxlint --type-aware --deny-warnings .",
    "openapi:check": "bun scripts/openapi/snapshot.ts --check",
    "openapi:snapshot": "bun scripts/openapi/snapshot.ts",
    "openapi:types": "bun scripts/openapi/types.ts",
    "openapi:types:check": "bun scripts/openapi/types.ts --check",
    "prepare": "husky",
    "quota": "bun scripts/dev/quota.ts",
    "reindex": "./scripts/es/reindex.sh",
    "reindex:prod": "./scripts/es/reindex-prod.sh",
    "rust:fmt": "cargo fmt --all --check",
    "rust:lint": "bun scripts/check/rust-lint.ts",
    "rust:test": "cargo test --workspace --locked",
    "rust:test:db": "bun scripts/dev/db-test.ts",
    "secrets:check": "bun scripts/secrets/check.ts",
    "secrets:edit": "./scripts/secrets/edit.sh",
    "secrets:pull": "./scripts/secrets/pull.sh",
    "smoke:dev": "bun scripts/smoke/run.ts",
    "smoke:stack": "bun scripts/smoke/run.ts stack",
    "smoke:prod": "bun scripts/smoke/run.ts prod",
    "taxonomy:generate": "bun scripts/taxonomy/generate.ts",
    "taxonomy:generate:dev": "bun scripts/taxonomy/generate.ts --dev",
    "taxonomy:generate:check": "bun scripts/taxonomy/generate.ts --check",
    "test": "turbo run test",
    "test:scripts": "bun test scripts",
    "types": "turbo run types",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "up": "./scripts/dev/compose.sh up -d --build",
    "well-known:generate": "bun scripts/well-known/generate.ts",
    "well-known:generate:check": "bun scripts/well-known/generate.ts --check"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@types/bun": "^1.4.2",
    "ajv": "^8.20.0",
    "dependency-cruiser": "18.2.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "libpg-query": "18.1.5",
    "neverthrow": "^8.2.0",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "squawk-cli": "2.66.0",
    "syncpack": "15.3.3",
    "ts-pattern": "^5.9.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "yaml": "^2.9.1",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.2",
    "vite": "^8.3.0",
    "js-yaml": "^4.3.2",
    "launch-editor": "^2.14.1",
    "@babel/core": "^7.29.7",
    "ws": "^8.21.3",
    "@opentelemetry/core": "^2.11.0",
    "undici": "^7.29.0",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.6",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "shell-quote": "^1.9.0",
    "svgo": "^4.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "devalue": "^5.9.4"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
