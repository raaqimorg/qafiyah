#!/usr/bin/env sh
set -e

refs="$(cat)"
if [ -n "$refs" ]; then
  printf '%s\n' "$refs" | ./scripts/check/commit-identity.sh pre-push
  printf '%s\n' "$refs" | ./scripts/check/forbidden-terms.sh pre-push
fi

echo "Running lint, format, and type checks (GitHub Actions runs the full gate)..."
bun run ci --phase static
bun run ci --phase checks
