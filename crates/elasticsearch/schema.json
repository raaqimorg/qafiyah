{
  "poems": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "analysis": {
        "char_filter": {
          "arabic_letter_folding": {
            "type": "mapping",
            "mappings": [
              "أ => ا",
              "إ => ا",
              "آ => ا",
              "ٱ => ا",
              "ى => ي",
              "ة => ه",
              "ـ => ",
              "ؤ => و",
              "ئ => ي",
              "ء => ",
              "ی => ي",
              "ک => ك",
              "\u0670 => ",
              "\u200b => ",
              "\u200c => ",
              "\u200d => ",
              "\u200e => ",
              "\u200f => ",
              "\u061c => ",
              "\ufeff => ",
              "\u2060 => ",
              "\u00ad => "
            ]
          },
          "arabic_letter_folding_keep_hamza": {
            "type": "mapping",
            "mappings": [
              "أ => ا",
              "إ => ا",
              "آ => ا",
              "ٱ => ا",
              "ى => ي",
              "ة => ه",
              "ـ => ",
              "ؤ => و",
              "ئ => ي",
              "ی => ي",
              "ک => ك",
              "\u0670 => ",
              "\u200b => ",
              "\u200c => ",
              "\u200d => ",
              "\u200e => ",
              "\u200f => ",
              "\u061c => ",
              "\ufeff => ",
              "\u2060 => ",
              "\u00ad => "
            ]
          },
          "invisible_marks": {
            "type": "pattern_replace",
            "pattern": "[\u0610-\u061a\u0653-\u065f\u06d6-\u06ed\u202a-\u202e\u2066-\u2069]",
            "replacement": ""
          },
          "name_compound_split": {
            "type": "pattern_replace",
            "pattern": "(^|\\s)(عبد(?=ال)|ابو(?=\\S\\S))",
            "replacement": "$1$2 "
          },
          "punctuation_as_space": {
            "type": "pattern_replace",
            "pattern": "\\p{P}+",
            "replacement": " "
          },
          "trimmed_spaces": {
            "type": "pattern_replace",
            "pattern": "^\\s+|\\s+$|(\\s)\\s+",
            "replacement": "$1"
          }
        },
        "filter": {
          "arabic_stop_filter": {
            "type": "stop",
            "stopwords": "_arabic_"
          },
          "arabic_stemmer_filter": {
            "type": "stemmer",
            "language": "arabic"
          },
          "edge_ngram_2": {
            "type": "edge_ngram",
            "min_gram": 2,
            "max_gram": 20
          },
          "name_equivalents": {
            "type": "synonym",
            "synonyms": [
              "ابن, بن",
              "ابو, ابي, ابا",
              "اخو, اخي, اخا",
              "ذو, ذي, ذا",
              "امرو, امري, امرا, امر"
            ]
          }
        },
        "analyzer": {
          "arabic_normalized": {
            "type": "custom",
            "char_filter": ["arabic_letter_folding", "invisible_marks"],
            "tokenizer": "standard",
            "filter": ["lowercase", "decimal_digit", "arabic_normalization"]
          },
          "arabic_stemmed": {
            "type": "custom",
            "char_filter": ["arabic_letter_folding", "invisible_marks"],
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "decimal_digit",
              "arabic_normalization",
              "arabic_stop_filter",
              "arabic_stemmer_filter"
            ]
          },
          "arabic_hamza_kept": {
            "type": "custom",
            "char_filter": ["arabic_letter_folding_keep_hamza", "invisible_marks"],
            "tokenizer": "standard",
            "filter": ["lowercase", "decimal_digit", "arabic_normalization"]
          },
          "arabic_name_normalized": {
            "type": "custom",
            "char_filter": ["arabic_letter_folding", "invisible_marks", "name_compound_split"],
            "tokenizer": "standard",
            "filter": ["lowercase", "decimal_digit", "arabic_normalization", "name_equivalents"]
          },
          "arabic_name_stemmed": {
            "type": "custom",
            "char_filter": ["arabic_letter_folding", "invisible_marks", "name_compound_split"],
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "decimal_digit",
              "arabic_normalization",
              "name_equivalents",
              "arabic_stop_filter",
              "arabic_stemmer_filter"
            ]
          },
          "autocomplete_name": {
            "type": "custom",
            "char_filter": ["arabic_letter_folding", "invisible_marks", "name_compound_split"],
            "tokenizer": "standard",
            "filter": [
              "lowercase",
              "decimal_digit",
              "arabic_normalization",
              "name_equivalents",
              "edge_ngram_2"
            ]
          }
        },
        "normalizer": {
          "arabic_exact": {
            "type": "custom",
            "char_filter": [
              "arabic_letter_folding_keep_hamza",
              "invisible_marks",
              "punctuation_as_space",
              "trimmed_spaces"
            ],
            "filter": ["lowercase", "decimal_digit", "arabic_normalization"]
          }
        }
      }
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "id": {
          "type": "integer"
        },
        "slug": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "title": {
          "type": "text",
          "analyzer": "arabic_normalized",
          "fields": {
            "hamza": {
              "type": "text",
              "analyzer": "arabic_hamza_kept"
            },
            "exact": {
              "type": "keyword",
              "normalizer": "arabic_exact",
              "ignore_above": 256
            },
            "stemmed": {
              "type": "text",
              "analyzer": "arabic_stemmed"
            }
          }
        },
        "content": {
          "type": "text",
          "analyzer": "arabic_normalized",
          "index_options": "offsets",
          "fields": {
            "hamza": {
              "type": "text",
              "analyzer": "arabic_hamza_kept",
              "index_options": "offsets"
            },
            "stemmed": {
              "type": "text",
              "analyzer": "arabic_stemmed",
              "index_options": "offsets"
            }
          }
        },
        "titleDisplay": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "poetNameDisplay": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "poetHasAvatar": {
          "type": "boolean",
          "index": false,
          "doc_values": false
        },
        "poetIsAnonymous": {
          "type": "boolean",
          "index": false,
          "doc_values": false
        },
        "poetSlug": {
          "type": "keyword"
        },
        "eraSlug": {
          "type": "keyword"
        },
        "eraName": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "meterSlug": {
          "type": "keyword"
        },
        "meterName": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "themeSlug": {
          "type": "keyword"
        },
        "rhymeSlug": {
          "type": "keyword"
        },
        "poemTypeSlug": {
          "type": "keyword"
        },
        "collectionSlug": {
          "type": "keyword"
        },
        "primaryId": {
          "type": "integer"
        },
        "isPrimary": {
          "type": "boolean"
        }
      }
    }
  },
