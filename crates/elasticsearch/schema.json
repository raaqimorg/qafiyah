            "filter": ["lowercase", "decimal_digit", "arabic_normalization"]
          }
        },
        "normalizer": {
          "arabic_exact": {
            "type": "custom",
            "char_filter": ["arabic_letter_folding_keep_hamza"],
            "filter": ["lowercase", "decimal_digit", "arabic_normalization"]
          }
        }
      }
