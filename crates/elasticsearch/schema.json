            "max_gram": 20
          }
        },
        "analyzer": {
          "arabic_normalized": {
            "type": "custom",
            "char_filter": ["arabic_letter_folding"],
            "tokenizer": "standard",
            "filter": ["lowercase", "decimal_digit", "arabic_normalization"]
          },
          "arabic_stemmed": {
            "type": "custom",
