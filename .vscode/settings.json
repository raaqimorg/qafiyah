{
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "editor.rulers": [80],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": "always",
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.renderLineHighlight": "all",
  "js/ts.format.enabled": false,
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[mdx]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[astro]": { "editor.defaultFormatter": "astro-build.astro-vscode" },
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
  "[toml]": { "editor.formatOnSave": false },
  "oxc.enable": true,
  "oxc.enable.oxfmt": true,
  "rust-analyzer.server.path": "rust-analyzer",
  "rust-analyzer.check.command": "clippy",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsserver.maxMemory": 8192,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferGoToSourceDefinition": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "editor.inlayHints.enabled": "offUnlessPressed",
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
  "css.lint.unknownAtRules": "ignore",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.includeLanguages": {
    "astro": "html"
  },
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["clsx\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "search.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/.astro": true,
    "**/.wrangler": true,
    "**/dist": true,
    "**/coverage": true,
    "**/bun.lock": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/target": true,
    "**/graft": true,
    "**/.turbo": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, .npmrc, turbo.json, tsconfig*.json, .oxlintrc.json, .oxfmtrc.json, knip.json, .dependency-cruiser.*, wrangler.jsonc, .hadolint.yaml, .mcp.json, .prettierrc.json, .squawk.toml",
    "Cargo.toml": "Cargo.lock, rust-toolchain.toml, arabic-text.vectors.json, clippy.toml",
    "Dockerfile": "docker-entrypoint.sh, nginx.conf, nginx-security-headers.conf, nginx-csp.conf, nginx-csp-api.conf, nginx-bad-bots.conf",
    "docker-compose.yml": "docker-compose.*.yml, .dockerignore",
    "*.ts": "${capture}.test.ts",
    "*.tsx": "${capture}.test.tsx",
    ".env": ".env.*, .sops.yaml",
    ".gitignore": ".ignore",
    "README.md": "AGENTS.md, CLAUDE.md, GEMINI.md, LICENSE",
    "astro.config.*": "env.d.ts, components.json, sentry.client.config.js, sentry.server.config.js"
  },
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.tree.indent": 16,
  "npm.packageManager": "bun",
  "git.branchProtection": [],
  "git.branchProtectionPrompt": "alwaysCommit",
  "cSpell.words": [
    "abbasi",
    "adabiyya",
    "aghrad",
    "alkamil",
    "almuallaqat",
    "alnasib",
    "altawil",
    "andalusi",
    "arabic",
    "astrojs",
    "buhur",
    "bunfig",
    "clippy",
    "cloudflare",
    "codegen",
    "dawawin",
    "drizzle",
    "envin",
    "fract",
    "gitleaks",
    "healthcheck",
    "healthz",
    "isready",
    "jahili",
    "knip",
    "llms",
    "marbuta",
    "meem",
    "milli",
    "neverthrow",
    "ngram",
    "onnotice",
    "oneshot",
    "orpc",
    "pgsql",
    "plpgsql",
    "postgres",
    "Qafiyah",
    "qawafi",
    "repages",
    "reqwest",
    "rustls",
    "serde",
    "sqlx",
    "tanstack",
    "tashkeel",
    "tawil",
    "thiserror",
    "turborepo",
    "unwires",
    "userinfo",
    "usur",
    "utoipa",
    "valibot",
    "workerd",
    "wrangler",
    "أحمد",
    "إغلاق",
    "الرئيسة",
    "الرئيسية",
    "القائمة",
    "المتنبي",
    "عباسي",
    "عربي",
    "عربى",
    "عروة",
    "قافية",
    "موبايل"
  ]
}
